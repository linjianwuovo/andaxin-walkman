<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_apple_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/widget_apple_surface" android:clipToOutline="true">
    <ImageView android:id="@+id/widget_apple_ambience"
        android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitXY"
        android:importantForAccessibility="no" android:visibility="gone" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="12dp">
        <FrameLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="6dp">
            <TextView android:id="@+id/widget_apple_section"
                android:layout_width="match_parent" android:layout_height="wrap_content" android:fontFamily="sans-serif-medium"
                android:includeFontPadding="false" android:singleLine="true" android:ellipsize="end" android:textSize="16sp"
                android:textColor="@color/widget_apple_header" android:text="@string/widget_apple_top_charts" android:layout_marginEnd="21dp" />
            <ImageView android:layout_width="15dp"
                android:layout_height="15dp" android:layout_gravity="top|end" android:src="@drawable/widget_meilox_mark"
                android:tint="@color/widget_apple_header" android:importantForAccessibility="no" />
        </FrameLayout>
        <LinearLayout android:id="@+id/widget_apple_cell_1"
            android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
            android:gravity="center_vertical" android:orientation="horizontal">
            <TextView android:id="@+id/widget_apple_number_1"
                android:layout_width="17dp" android:layout_height="wrap_content" android:fontFamily="sans-serif-medium"
                android:includeFontPadding="false" android:singleLine="true" android:ellipsize="end" android:textSize="12sp"
                android:textColor="@color/widget_apple_title" android:gravity="center_vertical" />
            <ImageView android:id="@+id/widget_apple_cover_1"
                android:layout_width="36dp" android:layout_height="36dp" android:scaleType="centerCrop"
                android:importantForAccessibility="no" android:background="@drawable/widget_apple_cover"
                android:clipToOutline="true" />
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="8dp" android:orientation="vertical">
                <TextView android:id="@+id/widget_apple_title_1"
                    android:layout_width="match_parent" android:layout_height="wrap_content" android:fontFamily="sans-serif-medium"
                    android:includeFontPadding="false" android:singleLine="true" android:ellipsize="end" android:textSize="13sp"
                    android:textColor="@color/widget_apple_title" />
                <TextView android:id="@+id/widget_apple_detail_1"
                    android:layout_width="match_parent" android:layout_height="wrap_content" android:fontFamily="sans-serif-medium"
                    android:includeFontPadding="false" android:singleLine="true" android:ellipsize="end" android:textSize="10sp"
                    android:textColor="@color/widget_apple_detail" android:layout_marginTop="1dp" />
            </LinearLayout>
            <ImageView android:id="@+id/widget_apple_row_play_1"
                android:layout_width="30dp" android:layout_height="30dp" android:layout_marginStart="8dp"
                android:padding="4dp" android:src="@drawable/widget_ic_play" android:tint="#FFFFFF"
                android:background="@drawable/widget_apple_capsule" android:contentDescription="@string/widget_play"
                android:visibility="gone" />
        </LinearLayout>
        <LinearLayout android:id="@+id/widget_apple_cell_2"
            android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
            android:gravity="center_vertical" android:orientation="horizontal">
            <TextView android:id="@+id/widget_apple_number_2"
                android:layout_width="17dp" android:layout_height="wrap_content" android:fontFamily="sans-serif-medium"
                android:includeFontPadding="false" android:singleLine="true" android:ellipsize="end" android:textSize="12sp"
                android:textColor="@color/widget_apple_title" android:gravity="center_vertical" />
            <ImageView android:id="@+id/widget_apple_cover_2"
                android:layout_width="36dp" android:layout_height="36dp" android:scaleType="centerCrop"
                android:importantForAccessibility="no" android:background="@drawable/widget_apple_cover"
                android:clipToOutline="true" />
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="8dp" android:orientation="vertical">
                <TextView android:id="@+id/widget_apple_title_2"
                    android:layout_width="match_parent" android:layout_height="wrap_content" android:fontFamily="sans-serif-medium"
                    android:includeFontPadding="false" android:singleLine="true" android:ellipsize="end" android:textSize="13sp"
                    android:textColor="@color/widget_apple_title" />
                <TextView android:id="@+id/widget_apple_detail_2"
                    android:layout_width="match_parent" android:layout_height="wrap_content" android:fontFamily="sans-serif-medium"
                    android:includeFontPadding="false" android:singleLine="true" android:ellipsize="end" android:textSize="10sp"
                    android:textColor="@color/widget_apple_detail" android:layout_marginTop="1dp" />
            </LinearLayout>
            <ImageView android:id="@+id/widget_apple_row_play_2"
                android:layout_width="30dp" android:layout_height="30dp" android:layout_marginStart="8dp"
                android:padding="4dp" android:src="@drawable/widget_ic_play" android:tint="#FFFFFF"
                android:background="@drawable/widget_apple_capsule" android:contentDescription="@string/widget_play"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
