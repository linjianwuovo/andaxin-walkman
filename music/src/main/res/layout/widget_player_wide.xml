<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center_vertical"
    android:paddingHorizontal="12dp"
    android:paddingTop="4dp"
    android:paddingBottom="3dp"
    android:background="@drawable/widget_ncm_classic_skin_translucent_dark"
    android:clipToOutline="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="22dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:adjustViewBounds="false"
            android:alpha="0.57"
            android:src="@drawable/widget_meilox_mark"
            android:importantForAccessibility="no" />

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <ImageView
            android:id="@+id/widget_search"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:adjustViewBounds="false"
            android:src="@drawable/widget_ncm_classic_search"
            android:layout_marginEnd="10dp"
            android:contentDescription="@string/search_bar_search"
            android:scaleType="fitCenter" />

        <ImageView
            android:id="@+id/widget_skin"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:adjustViewBounds="false"
            android:src="@drawable/widget_ncm_classic_skin"
            android:contentDescription="@string/settings_appearance"
            android:scaleType="fitCenter" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:baselineAligned="false">

        <ImageView
            android:id="@+id/widget_artwork"
            android:layout_width="84.7dp"
            android:layout_height="84.7dp"
            android:adjustViewBounds="false"
            android:src="@drawable/widget_ncm_classic_disc"
            android:scaleType="fitCenter"
            android:importantForAccessibility="no" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_weight="1"
            android:layout_marginStart="8dp">

            <TextView
                android:id="@+id/widget_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="16sp"
                android:textColor="#FFFFFF"
                android:maxLines="1"
                android:includeFontPadding="false"
                android:ellipsize="end"
                android:text="@string/widget_no_track" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="3dp"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/widget_subtitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:textSize="10.7sp"
                    android:textColor="#99FFFFFF"
                    android:maxLines="1"
                    android:includeFontPadding="false"
                    android:ellipsize="end"
                    android:layout_weight="1" />

                <TextView
                    android:id="@+id/widget_elapsed"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="8.7sp"
                    android:textColor="#FFFFFF"
                    android:maxLines="1"
                    android:includeFontPadding="false"
                    android:ellipsize="end"
                    android:text="0:00 / 0:00" />
            </LinearLayout>

            <ProgressBar
                android:id="@+id/widget_progress"
                android:layout_width="match_parent"
                android:layout_height="2dp"
                style="?android:attr/progressBarStyleHorizontal"
                android:indeterminate="false"
                android:progressDrawable="@drawable/widget_ncm_classic_progress"
                android:layout_marginTop="5dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="42.7dp"
                android:layout_marginTop="3dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:id="@+id/widget_mode"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:adjustViewBounds="false"
                    android:src="@drawable/widget_ncm_classic_repeat"
                    android:contentDescription="@string/player_action_play_mode"
                    android:scaleType="fitCenter" />

                <FrameLayout
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <ImageView
                    android:id="@+id/widget_prev"
                    android:layout_width="37.3dp"
                    android:layout_height="37.3dp"
                    android:adjustViewBounds="false"
                    android:src="@drawable/widget_ncm_classic_previous"
                    android:contentDescription="@string/widget_previous"
                    android:scaleType="fitCenter" />

                <ImageView
                    android:id="@+id/widget_play"
                    android:layout_width="42.7dp"
                    android:layout_height="42.7dp"
                    android:adjustViewBounds="false"
                    android:src="@drawable/widget_ncm_classic_play"
                    android:contentDescription="@string/widget_play"
                    android:scaleType="fitCenter"
                    android:layout_marginHorizontal="5dp" />

                <ImageView
                    android:id="@+id/widget_next"
                    android:layout_width="37.3dp"
                    android:layout_height="37.3dp"
                    android:adjustViewBounds="false"
                    android:src="@drawable/widget_ncm_classic_next"
                    android:contentDescription="@string/widget_next"
                    android:scaleType="fitCenter" />

                <FrameLayout
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <ImageView
                    android:id="@+id/widget_like"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:adjustViewBounds="false"
                    android:src="@drawable/widget_ncm_classic_like"
                    android:contentDescription="@string/widget_add_favorite"
                    android:scaleType="fitCenter" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
