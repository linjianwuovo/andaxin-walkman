<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_ncm_mini_clip"
    android:clipToOutline="true">

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:adjustViewBounds="false"
        android:src="@drawable/widget_ncm_vinyl_background"
        android:scaleType="fitXY"
        android:importantForAccessibility="no" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:gravity="center_vertical">

        <FrameLayout
            android:layout_width="1dp"
            android:layout_height="0dp"
            android:layout_weight="16" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:orientation="horizontal"
            android:layout_weight="54"
            android:gravity="center_vertical"
            android:baselineAligned="false">

            <FrameLayout
                android:layout_width="54dp"
                android:layout_height="54dp">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:adjustViewBounds="false"
                    android:src="@drawable/widget_ncm_vinyl_disc"
                    android:scaleType="fitCenter"
                    android:importantForAccessibility="no" />

                <ImageView
                    android:id="@+id/widget_artwork"
                    android:layout_width="33.94dp"
                    android:layout_height="33.94dp"
                    android:adjustViewBounds="false"
                    android:src="@mipmap/ic_launcher_round"
                    android:scaleType="centerCrop"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="14dp"
                android:layout_weight="1">

                <TextView
                    android:id="@+id/widget_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="14sp"
                    android:textColor="#FFFFFF"
                    android:maxLines="2"
                    android:includeFontPadding="false"
                    android:ellipsize="end"
                    android:text="@string/widget_no_track" />

                <TextView
                    android:id="@+id/widget_subtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="12sp"
                    android:textColor="#99FFFFFF"
                    android:maxLines="1"
                    android:includeFontPadding="false"
                    android:ellipsize="end"
                    android:layout_marginTop="4dp" />
            </LinearLayout>

            <ImageView
                android:id="@+id/widget_like"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:adjustViewBounds="false"
                android:layout_marginEnd="18dp"
                android:src="@drawable/widget_ncm_vinyl_like"
                android:contentDescription="@string/widget_add_favorite"
                android:scaleType="fitCenter" />

            <ImageView
                android:id="@+id/widget_play"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:adjustViewBounds="false"
                android:src="@drawable/widget_ncm_vinyl_play"
                android:contentDescription="@string/widget_play"
                android:scaleType="fitCenter" />

            <ImageView
                android:id="@+id/widget_next"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:adjustViewBounds="false"
                android:layout_marginStart="18dp"
                android:src="@drawable/widget_ncm_vinyl_next"
                android:contentDescription="@string/widget_next"
                android:scaleType="fitCenter" />

            <ImageView
                android:id="@+id/widget_prev"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:adjustViewBounds="false"
                android:visibility="gone" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="1dp"
            android:layout_height="0dp"
            android:layout_weight="16" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:orientation="horizontal"
            android:layout_weight="48">

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1">

                <ImageView
                    android:id="@+id/widget_vinyl_one"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:adjustViewBounds="false"
                    android:background="@drawable/widget_ncm_vinyl_tile"
                    android:clipToOutline="true"
                    android:layout_gravity="center"
                    android:scaleType="centerCrop" />
            </FrameLayout>

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1">

                <ImageView
                    android:id="@+id/widget_vinyl_two"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:adjustViewBounds="false"
                    android:background="@drawable/widget_ncm_vinyl_tile"
                    android:clipToOutline="true"
                    android:layout_gravity="center"
                    android:scaleType="centerCrop" />
            </FrameLayout>

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1">

                <ImageView
                    android:id="@+id/widget_vinyl_three"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:adjustViewBounds="false"
                    android:background="@drawable/widget_ncm_vinyl_tile"
                    android:clipToOutline="true"
                    android:layout_gravity="center"
                    android:scaleType="centerCrop" />
            </FrameLayout>

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1">

                <ImageView
                    android:id="@+id/widget_vinyl_four"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:adjustViewBounds="false"
                    android:background="@drawable/widget_ncm_vinyl_tile"
                    android:clipToOutline="true"
                    android:layout_gravity="center"
                    android:scaleType="centerCrop" />
            </FrameLayout>

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1">

                <ImageView
                    android:id="@+id/widget_vinyl_five"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:adjustViewBounds="false"
                    android:background="@drawable/widget_ncm_vinyl_tile"
                    android:clipToOutline="true"
                    android:layout_gravity="center"
                    android:scaleType="centerCrop" />
            </FrameLayout>
        </LinearLayout>

        <FrameLayout
            android:layout_width="1dp"
            android:layout_height="0dp"
            android:layout_weight="16" />
    </LinearLayout>
</FrameLayout>
