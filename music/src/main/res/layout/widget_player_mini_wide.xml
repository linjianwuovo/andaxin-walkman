<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_ncm_mini_clip"
    android:clipToOutline="true">

    <ImageView
        android:id="@+id/widget_mini_background"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:adjustViewBounds="false"
        android:src="@drawable/widget_ncm_mini_wide"
        android:scaleType="centerCrop"
        android:importantForAccessibility="no" />

    <ImageView
        android:layout_width="21dp"
        android:layout_height="21dp"
        android:adjustViewBounds="false"
        android:src="@drawable/widget_meilox_badge"
        android:importantForAccessibility="no"
        android:layout_gravity="top|end"
        android:layout_margin="11dp"
        android:alpha="0.3" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="12dp"
        android:paddingEnd="27dp"
        android:baselineAligned="false">

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginVertical="10dp"
            android:layout_weight="47">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:adjustViewBounds="false"
                android:src="@drawable/widget_ncm_mini_disc"
                android:scaleType="fitCenter"
                android:importantForAccessibility="no" />

            <ImageView
                android:id="@+id/widget_artwork"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:adjustViewBounds="false"
                android:src="@drawable/widget_ncm_mini_cover_placeholder"
                android:scaleType="fitCenter"
                android:importantForAccessibility="no" />
        </FrameLayout>

        <RelativeLayout
            android:layout_width="0dp"
            android:layout_height="120dp"
            android:layout_marginStart="8dp"
            android:layout_weight="53">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_alignParentTop="true"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/widget_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="14dp"
                    android:textSize="18sp"
                    android:textColor="#FFFFFF"
                    android:maxLines="2"
                    android:includeFontPadding="false"
                    android:ellipsize="end"
                    android:text="@string/widget_no_track"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/widget_subtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="7dp"
                    android:textSize="13sp"
                    android:textColor="#99FFFFFF"
                    android:maxLines="1"
                    android:includeFontPadding="false"
                    android:ellipsize="end" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="26dp"
                android:layout_alignParentBottom="true"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:id="@+id/widget_prev"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:adjustViewBounds="false"
                    android:src="@drawable/widget_ncm_previous"
                    android:contentDescription="@string/widget_previous"
                    android:scaleType="fitCenter" />

                <FrameLayout
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <ImageView
                    android:id="@+id/widget_play"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:adjustViewBounds="false"
                    android:src="@drawable/widget_ncm_play"
                    android:contentDescription="@string/widget_play"
                    android:scaleType="fitCenter" />

                <FrameLayout
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <ImageView
                    android:id="@+id/widget_next"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:adjustViewBounds="false"
                    android:src="@drawable/widget_ncm_next"
                    android:contentDescription="@string/widget_next"
                    android:scaleType="fitCenter" />

                <FrameLayout
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <ImageView
                    android:id="@+id/widget_like"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:adjustViewBounds="false"
                    android:src="@drawable/widget_ncm_like"
                    android:contentDescription="@string/widget_add_favorite"
                    android:scaleType="fitCenter" />
            </LinearLayout>
        </RelativeLayout>
    </LinearLayout>
</FrameLayout>
