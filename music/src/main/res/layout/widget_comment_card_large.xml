<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_ncm_comment_background"
    android:clipToOutline="true">

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/widget_ncm_comment_background_large" />

    <ImageView
        android:layout_width="26dp"
        android:layout_height="26dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="15.5dp"
        android:layout_marginEnd="15.5dp"
        android:importantForAccessibility="no"
        android:tint="#DD001B"
        android:src="@drawable/widget_meilox_badge" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="45dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="10dp"
        android:orientation="horizontal"
        android:baselineAligned="false">

        <TextView
            android:id="@+id/widget_comment_month"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:includeFontPadding="false"
            android:singleLine="true"
            android:fontFamily="serif"
            android:textStyle="bold|italic"
            android:textSize="39sp"
            android:textColor="#DD001B" />

        <TextView
            android:id="@+id/widget_comment_day"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="2dp"
            android:layout_marginTop="5dp"
            android:includeFontPadding="false"
            android:singleLine="true"
            android:fontFamily="serif"
            android:textStyle="bold|italic"
            android:textSize="20sp"
            android:textColor="#DD001B" />

        <TextView
            android:id="@+id/widget_comment_weekday"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="5dp"
            android:layout_marginTop="4dp"
            android:singleLine="true"
            android:textStyle="bold"
            android:textSize="13sp"
            android:textColor="#DD001B" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginHorizontal="32dp"
        android:layout_marginTop="55dp"
        android:layout_marginBottom="62dp"
        android:gravity="center_vertical"
        android:orientation="vertical">

        <TextView
            android:id="@+id/widget_comment_quote"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="6"
            android:includeFontPadding="false"
            android:ellipsize="end"
            android:lineSpacingMultiplier="1.2"
            android:textSize="20sp"
            android:textColor="#000000"
            android:autoSizeTextType="uniform"
            android:autoSizeMinTextSize="12sp"
            android:autoSizeMaxTextSize="20sp"
            android:autoSizeStepGranularity="2sp" />

        <TextView
            android:id="@+id/widget_comment_author"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:includeFontPadding="false"
            android:ellipsize="end"
            android:singleLine="true"
            android:textSize="12sp"
            android:textColor="#99000000" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="38.5dp"
        android:layout_gravity="bottom"
        android:layout_marginStart="15dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="23dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:baselineAligned="false">

        <FrameLayout
            android:layout_width="38.5dp"
            android:layout_height="match_parent"
            android:background="@drawable/widget_ncm_comment_disc">

            <ImageView
                android:id="@+id/widget_artwork"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:background="@drawable/widget_ncm_disc_mask"
                android:clipToOutline="true"
                android:scaleType="centerCrop"
                android:importantForAccessibility="no"
                android:src="@mipmap/ic_launcher_round" />
        </FrameLayout>

        <TextView
            android:id="@+id/widget_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:maxEms="8"
            android:ellipsize="end"
            android:singleLine="true"
            android:includeFontPadding="false"
            android:textSize="13sp"
            android:textColor="#000000" />

        <TextView
            android:id="@+id/widget_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:maxEms="4"
            android:ellipsize="end"
            android:singleLine="true"
            android:includeFontPadding="false"
            android:textSize="13sp"
            android:textColor="#99000000" />

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1" />

        <ImageView
            android:id="@+id/widget_play"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginStart="8dp"
            android:contentDescription="@string/widget_play"
            android:scaleType="fitCenter"
            android:src="@drawable/widget_ncm_comment_play" />
    </LinearLayout>
</FrameLayout>
