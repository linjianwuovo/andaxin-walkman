<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_ncm_mini_clip"
    android:clipToOutline="true">

    <ImageView
        android:id="@+id/widget_mini_background"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:adjustViewBounds="false"
        android:src="@drawable/widget_ncm_mini_square"
        android:scaleType="centerCrop"
        android:importantForAccessibility="no" />

    <ImageView
        android:layout_width="21dp"
        android:layout_height="21dp"
        android:layout_gravity="top|end"
        android:layout_margin="11dp"
        android:alpha="0.3"
        android:importantForAccessibility="no"
        android:src="@drawable/widget_meilox_badge" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center_horizontal">

        <FrameLayout
            android:layout_width="1dp"
            android:layout_height="0dp"
            android:layout_weight="8" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="57"
            android:gravity="center"
            android:orientation="horizontal"
            android:weightSum="99">

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="66">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:adjustViewBounds="false"
                    android:src="@drawable/widget_ncm_mini_disc"
                    android:scaleType="fitCenter"
                    android:importantForAccessibility="no" />

                <ImageView
                    android:id="@+id/widget_artwork"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:adjustViewBounds="false"
                    android:src="@drawable/widget_ncm_mini_cover_placeholder"
                    android:scaleType="fitCenter"
                    android:importantForAccessibility="no" />
            </FrameLayout>
        </LinearLayout>

        <FrameLayout
            android:layout_width="1dp"
            android:layout_height="0dp"
            android:layout_weight="5" />

        <TextView
            android:id="@+id/widget_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="18dp"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:maxLines="1"
            android:includeFontPadding="false"
            android:ellipsize="end"
            android:text="@string/widget_no_track"
            android:gravity="center" />

        <FrameLayout
            android:layout_width="1dp"
            android:layout_height="0dp"
            android:layout_weight="12" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="26dp"
            android:layout_marginHorizontal="18dp"
            android:orientation="horizontal"
            android:gravity="center">

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1">

                <ImageView
                    android:id="@+id/widget_like"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:adjustViewBounds="false"
                    android:src="@drawable/widget_ncm_like"
                    android:contentDescription="@string/widget_add_favorite"
                    android:scaleType="fitCenter" />
            </FrameLayout>

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1">

                <ImageView
                    android:id="@+id/widget_play"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:layout_gravity="center"
                    android:adjustViewBounds="false"
                    android:src="@drawable/widget_ncm_play"
                    android:contentDescription="@string/widget_play"
                    android:scaleType="fitCenter" />
            </FrameLayout>

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1">

                <ImageView
                    android:id="@+id/widget_next"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:adjustViewBounds="false"
                    android:src="@drawable/widget_ncm_next"
                    android:contentDescription="@string/widget_next"
                    android:scaleType="fitCenter" />
            </FrameLayout>
        </LinearLayout>

        <FrameLayout
            android:layout_width="1dp"
            android:layout_height="0dp"
            android:layout_weight="8" />
    </LinearLayout>
</FrameLayout>
