<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_ncm_classic_background"
    android:clipToOutline="true">

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:adjustViewBounds="false"
        android:src="@drawable/widget_ncm_classic_cover"
        android:scaleType="centerCrop"
        android:importantForAccessibility="no" />

    <ImageView
        android:id="@+id/widget_artwork"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:adjustViewBounds="false"
        android:scaleType="centerCrop"
        android:importantForAccessibility="no" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/widget_ncm_classic_cover_scrim" />

    <ImageView
        android:id="@+id/widget_search"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:adjustViewBounds="false"
        android:src="@drawable/widget_ncm_classic_search"
        android:contentDescription="@string/search_bar_search"
        android:scaleType="fitCenter"
        android:padding="6dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="14.7dp"
        android:layout_marginEnd="12dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_gravity="bottom"
        android:paddingHorizontal="12dp"
        android:paddingBottom="16dp">

        <TextView
            android:id="@+id/widget_lyric_previous"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="13.3sp"
            android:textColor="#80FFFFFF"
            android:maxLines="1"
            android:includeFontPadding="false"
            android:ellipsize="end"
            android:gravity="center"
            android:layout_marginBottom="3dp" />

        <TextView
            android:id="@+id/widget_lyric"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="13.3sp"
            android:textColor="#FFFFFF"
            android:maxLines="1"
            android:includeFontPadding="false"
            android:ellipsize="end"
            android:gravity="center" />

        <TextView
            android:id="@+id/widget_lyric_next"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="13.3sp"
            android:textColor="#80FFFFFF"
            android:maxLines="1"
            android:includeFontPadding="false"
            android:ellipsize="end"
            android:gravity="center"
            android:layout_marginTop="3dp"
            android:layout_marginBottom="22dp" />

        <ProgressBar
            android:id="@+id/widget_progress"
            android:layout_width="match_parent"
            android:layout_height="2dp"
            style="?android:attr/progressBarStyleHorizontal"
            android:indeterminate="false"
            android:progressDrawable="@drawable/widget_ncm_classic_progress"
            android:layout_marginBottom="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="12dp">

            <TextView
                android:id="@+id/widget_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:textSize="14sp"
                android:textColor="#FFFFFF"
                android:maxLines="1"
                android:includeFontPadding="false"
                android:ellipsize="end"
                android:text="@string/widget_no_track"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/widget_elapsed"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="8.7sp"
                android:textColor="#FFFFFF"
                android:maxLines="1"
                android:includeFontPadding="false"
                android:ellipsize="end"
                android:text="0:00 / 0:00" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="45dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:id="@+id/widget_mode"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:adjustViewBounds="false"
                android:src="@drawable/widget_ncm_classic_large_repeat"
                android:layout_marginStart="9dp"
                android:contentDescription="@string/player_action_play_mode"
                android:scaleType="fitCenter" />

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <ImageView
                android:id="@+id/widget_prev"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:adjustViewBounds="false"
                android:src="@drawable/widget_ncm_classic_large_previous"
                android:contentDescription="@string/widget_previous"
                android:scaleType="fitCenter" />

            <ImageView
                android:id="@+id/widget_play"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:adjustViewBounds="false"
                android:src="@drawable/widget_ncm_classic_large_play"
                android:contentDescription="@string/widget_play"
                android:scaleType="fitCenter"
                android:layout_marginHorizontal="22dp" />

            <ImageView
                android:id="@+id/widget_next"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:adjustViewBounds="false"
                android:src="@drawable/widget_ncm_classic_large_next"
                android:contentDescription="@string/widget_next"
                android:scaleType="fitCenter" />

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <ImageView
                android:id="@+id/widget_like"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:adjustViewBounds="false"
                android:src="@drawable/widget_ncm_classic_large_like"
                android:layout_marginEnd="9dp"
                android:contentDescription="@string/widget_add_favorite"
                android:scaleType="fitCenter" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
