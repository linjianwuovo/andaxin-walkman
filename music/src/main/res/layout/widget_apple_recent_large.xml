<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_apple_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/widget_apple_surface" android:clipToOutline="true">
    <ImageView android:id="@+id/widget_apple_ambience"
        android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitXY"
        android:importantForAccessibility="no" android:visibility="gone" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
        android:paddingVertical="16dp" android:orientation="vertical">
        <LinearLayout android:id="@+id/widget_apple_hero"
            android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="36"
            android:paddingHorizontal="16dp" android:paddingBottom="12dp"
            android:gravity="center_vertical" android:orientation="horizontal">
            <ImageView android:id="@+id/widget_apple_hero_art"
                android:layout_width="77dp" android:layout_height="77dp" android:scaleType="centerCrop"
                android:clipToOutline="true" android:importantForAccessibility="no" />
            <LinearLayout android:layout_width="0dp"
                android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="16dp"
                android:orientation="vertical" android:gravity="start">
                <TextView android:id="@+id/widget_apple_hero_section"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="@string/widget_apple_now_playing"
                    android:textAllCaps="true" android:textStyle="bold" android:textSize="11sp"
                    android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end"
                    android:textColor="@color/widget_apple_title" android:layout_marginEnd="21dp" />
                <TextView android:id="@+id/widget_apple_hero_title"
                    android:layout_width="match_parent" android:layout_height="wrap_content" android:fontFamily="sans-serif-medium"
                    android:includeFontPadding="false" android:singleLine="true" android:ellipsize="end" android:textSize="16sp"
                    android:textColor="@color/widget_apple_title" android:layout_marginEnd="9dp" />
                <TextView android:id="@+id/widget_apple_hero_subtitle"
                    android:layout_width="match_parent" android:layout_height="wrap_content" android:fontFamily="sans-serif"
                    android:includeFontPadding="false" android:singleLine="true" android:ellipsize="end" android:textSize="12sp"
                    android:textColor="@color/widget_apple_detail" />
                <LinearLayout android:id="@+id/widget_apple_hero_play"
                    android:layout_width="wrap_content" android:layout_height="32dp" android:gravity="center_vertical"
                    android:orientation="horizontal" android:paddingEnd="8dp" android:visibility="gone">
                    <ImageView android:id="@+id/widget_apple_hero_play_icon"
                        android:layout_width="20dp" android:layout_height="20dp" android:src="@drawable/widget_ic_play"
                        android:tint="#FFFFFF" android:importantForAccessibility="no" />
                    <TextView android:id="@+id/widget_apple_hero_play_label"
                        android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="6dp"
                        android:singleLine="true" android:includeFontPadding="false" android:fontFamily="sans-serif" android:textStyle="bold"
                        android:textSize="14sp" android:textColor="#99FFFFFF" android:text="@string/widget_play" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
        <LinearLayout android:id="@+id/widget_apple_history"
            android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="64"
            android:orientation="vertical" android:paddingHorizontal="16dp" android:paddingTop="11dp"
            android:background="@drawable/widget_apple_history_scrim">
            <FrameLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="8dp">
                <TextView android:id="@+id/widget_apple_section"
                    android:layout_width="match_parent" android:layout_height="wrap_content" android:fontFamily="sans-serif-medium"
                    android:includeFontPadding="false" android:singleLine="true" android:ellipsize="end"
                    android:textAllCaps="true" android:textStyle="bold" android:textSize="11sp"
                    android:textColor="@color/widget_apple_title" android:text="@string/widget_recent"
                    android:layout_marginEnd="21dp" />
            </FrameLayout>
            <LinearLayout android:id="@+id/widget_apple_cell_1"
                android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
                android:gravity="center_vertical" android:orientation="horizontal">
                <ImageView android:id="@+id/widget_apple_cover_1"
                    android:layout_width="34dp" android:layout_height="34dp" android:scaleType="centerCrop"
                    android:importantForAccessibility="no" android:background="@drawable/widget_apple_cover"
                    android:clipToOutline="true" />
                <LinearLayout android:layout_width="0dp"
                    android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="12dp"
                    android:orientation="vertical">
                    <TextView android:id="@+id/widget_apple_title_1"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium" android:includeFontPadding="false" android:singleLine="true"
                        android:ellipsize="end" android:textSize="14sp" android:textColor="@color/widget_apple_title" />
                    <TextView android:id="@+id/widget_apple_detail_1"
                        android:layout_width="match_parent" android:layout_height="wrap_content" android:fontFamily="sans-serif"
                        android:includeFontPadding="false" android:singleLine="true" android:ellipsize="end"
                        android:textSize="11sp" android:textColor="@color/widget_apple_detail" />
                </LinearLayout>
                <ImageView android:id="@+id/widget_apple_row_play_1"
                    android:layout_width="30dp" android:layout_height="30dp" android:layout_marginStart="8dp"
                    android:padding="4dp" android:src="@drawable/widget_ic_play" android:tint="#FFFFFF"
                    android:background="@drawable/widget_apple_capsule" android:contentDescription="@string/widget_play"
                    android:visibility="gone" />
            </LinearLayout>
            <LinearLayout android:id="@+id/widget_apple_cell_2"
                android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
                android:layout_marginTop="12dp" android:gravity="center_vertical" android:orientation="horizontal">
                <ImageView android:id="@+id/widget_apple_cover_2"
                    android:layout_width="34dp" android:layout_height="34dp" android:scaleType="centerCrop"
                    android:importantForAccessibility="no" android:background="@drawable/widget_apple_cover"
                    android:clipToOutline="true" />
                <LinearLayout android:layout_width="0dp"
                    android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="12dp"
                    android:orientation="vertical">
                    <TextView android:id="@+id/widget_apple_title_2"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium" android:includeFontPadding="false" android:singleLine="true"
                        android:ellipsize="end" android:textSize="14sp" android:textColor="@color/widget_apple_title" />
                    <TextView android:id="@+id/widget_apple_detail_2"
                        android:layout_width="match_parent" android:layout_height="wrap_content" android:fontFamily="sans-serif"
                        android:includeFontPadding="false" android:singleLine="true" android:ellipsize="end"
                        android:textSize="11sp" android:textColor="@color/widget_apple_detail" />
                </LinearLayout>
                <ImageView android:id="@+id/widget_apple_row_play_2"
                    android:layout_width="30dp" android:layout_height="30dp" android:layout_marginStart="8dp"
                    android:padding="4dp" android:src="@drawable/widget_ic_play" android:tint="#FFFFFF"
                    android:background="@drawable/widget_apple_capsule" android:contentDescription="@string/widget_play"
                    android:visibility="gone" />
            </LinearLayout>
            <LinearLayout android:id="@+id/widget_apple_cell_3"
                android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
                android:layout_marginTop="12dp" android:gravity="center_vertical" android:orientation="horizontal">
                <ImageView android:id="@+id/widget_apple_cover_3"
                    android:layout_width="34dp" android:layout_height="34dp" android:scaleType="centerCrop"
                    android:importantForAccessibility="no" android:background="@drawable/widget_apple_cover"
                    android:clipToOutline="true" />
                <LinearLayout android:layout_width="0dp"
                    android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="12dp"
                    android:orientation="vertical">
                    <TextView android:id="@+id/widget_apple_title_3"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium" android:includeFontPadding="false" android:singleLine="true"
                        android:ellipsize="end" android:textSize="14sp" android:textColor="@color/widget_apple_title" />
                    <TextView android:id="@+id/widget_apple_detail_3"
                        android:layout_width="match_parent" android:layout_height="wrap_content" android:fontFamily="sans-serif"
                        android:includeFontPadding="false" android:singleLine="true" android:ellipsize="end"
                        android:textSize="11sp" android:textColor="@color/widget_apple_detail" />
                </LinearLayout>
                <ImageView android:id="@+id/widget_apple_row_play_3"
                    android:layout_width="30dp" android:layout_height="30dp" android:layout_marginStart="8dp"
                    android:padding="4dp" android:src="@drawable/widget_ic_play" android:tint="#FFFFFF"
                    android:background="@drawable/widget_apple_capsule" android:contentDescription="@string/widget_play"
                    android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
    <ImageView android:layout_width="15dp" android:layout_height="15dp"
        android:layout_gravity="top|end" android:layout_margin="16dp"
        android:src="@drawable/widget_meilox_mark" android:tint="@color/widget_apple_header"
        android:importantForAccessibility="no" />
</FrameLayout>
