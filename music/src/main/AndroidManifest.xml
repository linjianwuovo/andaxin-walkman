<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 并进安大信之后这里只剩"音乐这一块自己要用什么"：
         Application、启动图标、进程名、主题、backup 策略全部归宿主所有，
         这一层一个 application 属性都不写，合并时不会跟宿主抢。 -->

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- 读本地音频（媒体库「扫描本地音乐」）与脚本音源的悬浮窗。上游 app/src/main/AndroidManifest.xml:8-11
         有这三条，宿主收音乐模块时漏了，导致 checkSelfPermission 恒为拒绝、扫不出任何歌。 -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <!-- 本地 MCP：局域网暴露要这条（上游 manifest:6） -->
    <uses-permission android:name="android.permission.ACCESS_LOCAL_NETWORK" />

    <uses-feature
        android:name="android.hardware.camera.any"
        android:required="false" />

    <application>
        <!-- 登录风控里用 MockPackageManager 顶掉真机 PackageManager -->
        <uses-library
            android:name="android.test.mock"
            android:required="false" />

        <meta-data
            android:name="${applicationId}.BUILD_ID"
            android:value="${mei_build_id}" />
        <meta-data
            android:name="lyricon_module"
            android:value="true" />
        <meta-data
            android:name="lyricon_module_author"
            android:value="NEORUAA" />
        <meta-data
            android:name="lyricon_module_description"
            android:value="@string/system_lyrics_description" />
        <meta-data
            android:name="lyricon_module_tags"
            android:resource="@array/lyricon_module_tags" />
        <meta-data
            android:name="io.github.andrealtb.lockscreenlyrics.OPLUS_MEDIA_HISTORY"
            android:value="true" />

        <!-- 脚本音源跑在独立沙箱进程里（上游 app/src/main/AndroidManifest.xml:80-84）。 -->
        <service
            android:name=".source.script.QuickJsEngineService"
            android:exported="false"
            android:isolatedProcess="true"
            android:process=":source_sandbox" />

        <!-- 分享/导入文件要能给别的 app 发 content://（上游 app/src/main/AndroidManifest.xml:54-62）。 -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- 由安大信内部拉起，不进桌面：没有 LAUNCHER / APP_MUSIC 两条 category，
             否则装完会多出第二个图标。 -->
        <activity
            android:name=".MainActivity"
            android:configChanges="screenSize|smallestScreenSize|screenLayout|orientation|uiMode"
            android:exported="false"
            android:supportsPictureInPicture="true"
            android:theme="@style/Theme.Music"
            tools:ignore="MissingClass" />


<!-- 桌面小组件：上游 app/src/main/AndroidManifest.xml 的 32 枚 receiver 与配置 Activity 整块。
     组件类都在 music/src/main/java/com/ljyh/mei/widget/，预览布局在 res/xml/widget_*。
     点击回跳的 MainActivity 是宿主壳，widget 深链由 MusicScreen 的派发 LaunchedEffect 消费。 -->
        <receiver android:name=".widget.PlayerWidget" android:label="@string/widget_player_mini" android:exported="false">
        <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
